<div class="card-body">
    <div class="h-64 flex items-center justify-center" role="alert">
        <div class="alert alert-error">
            <span>@Message</span>
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment Message { get; set; } = DefaultMessage;

    private static readonly RenderFragment DefaultMessage = builder => builder.AddContent(0, "Failed to load chart");

    public static RenderFragment AsRenderFragment() => AsRenderFragment(DefaultMessage);

    public static RenderFragment AsRenderFragment(RenderFragment message) => builder =>
    {
        builder.OpenComponent<ChartError>(0);
        builder.AddAttribute(1, nameof(Message), message);
        builder.CloseComponent();
    };

}
