@implements AnimeFeedManager.Web.BlazorComponents.IRenderableComponent<NotificationModel>
@* Crayon-themed episode notification. Fluid-hybrid: no media queries (Gmail apps strip head styles). *@
@if (ViewModel is not null)
{
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light">
        <meta name="supported-color-schemes" content="light">
        <title>New episodes</title>
    </head>
    <body style="margin:0; padding:0; background-color:@Warm; color:@Ink; font-family:@Marker; -webkit-text-size-adjust:100%;">

    @* Inbox preview line; padded so clients don't pull body copy in after it. *@
    <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:transparent; height:0; width:0;">
        @ViewModel.TotalEpisodeCount new episode@(ViewModel.TotalEpisodeCount != 1 ? "s" : "") ready to grab.
        &#8203;&#847;&zwnj;&nbsp;&#8203;&#847;&zwnj;&nbsp;&#8203;&#847;&zwnj;&nbsp;&#8203;&#847;&zwnj;&nbsp;
    </div>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color:@Warm;">
        <tr>
            <td align="center" style="padding:16px 12px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width:600px; margin:0 auto;">

                    @* Masthead *@
                    <tr>
                        <td style="padding:0 0 20px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="background-color:@Ink; padding:0 @Offset @Offset 0; border-radius:@Wobble;">
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td style="background-color:@Red; border:2px solid @Ink; border-radius:@Wobble; padding:22px 20px; text-align:center;">
                                                    <h1 style="margin:0; font-family:@Marker; font-size:26px; font-weight:700; line-height:1.2; color:@Ink;">
                                                        🎬 New Episodes
                                                    </h1>
                                                    <p style="margin:6px 0 0; font-size:13px; font-weight:700; color:@Ink;">
                                                        @DateTime.Today.ToString("MMMM dd, yyyy")
                                                    </p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    @* Greeting *@
                    <tr>
                        <td style="padding:0 4px 20px;">
                            <p style="margin:0; font-size:17px; font-weight:700; color:@Ink;">
                                Hi @ViewModel.UserName,
                            </p>
                            <p style="margin:6px 0 0; font-size:14px; line-height:1.5; color:@Muted;">
                                You have
                                <strong style="color:@Ink;">@ViewModel.TotalEpisodeCount new episode@(ViewModel.TotalEpisodeCount != 1 ? "s" : "")</strong>
                                waiting from your subscriptions.
                            </p>
                        </td>
                    </tr>

                    @* Series cards *@
                    @foreach (var anime in ViewModel.AnimeFeeds)
                    {
                        <tr>
                            <td style="padding:0 0 18px;">
                                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                    <tr>
                                        <td style="background-color:@Ink; padding:0 @Offset @Offset 0; border-radius:@Wobble;">
                                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color:@Paper; border:2px solid @Ink; border-radius:@Wobble;">

                                                @* Series header doubles as the SubsPlease link *@
                                                <tr>
                                                    <td style="background-color:@Warm; border-bottom:2px solid @Ink; border-radius:@WobbleTop;">
                                                        <a href="@anime.Url"
                                                           style="display:block; padding:14px 16px; text-decoration:none; color:@Ink;">
                                                            <span style="font-family:@Marker; font-size:17px; font-weight:700; color:@Ink;">
                                                                @anime.Title
                                                            </span>
                                                            <span style="color:@Red; font-weight:700;">&nbsp;&rarr;</span>
                                                            <span style="display:block; margin-top:3px; font-size:12px; font-weight:700; color:@Muted;">
                                                                @anime.Episodes.Length episode@(anime.Episodes.Length != 1 ? "s" : "") &middot; view on SubsPlease
                                                            </span>
                                                        </a>
                                                    </td>
                                                </tr>

                                                @{ var first = true; }
                                                @foreach (var episode in anime.Episodes.OrderByDescending(e => e.EpisodeNumber))
                                                {
                                                    <tr>
                                                        <td style="padding:14px 16px; @(first ? "" : $"border-top:2px dashed {Ink};")">
                                                            <p style="margin:0 0 10px;">
                                                                <span style="display:inline-block; background-color:@Red; color:@Ink; border:2px solid @Ink; border-radius:@WobbleSm; padding:3px 10px; font-size:12px; font-weight:700;">
                                                                    EP @episode.EpisodeNumber
                                                                </span>
                                                                @if (episode.IsNew)
                                                                {
                                                                    <span style="display:inline-block; margin-left:6px; background-color:@Yellow; color:@Ink; border:2px solid @Ink; border-radius:@WobbleSm; padding:3px 9px; font-size:11px; font-weight:700;">
                                                                        NEW
                                                                    </span>
                                                                }
                                                            </p>
                                                            @* inline-block buttons wrap on narrow screens without a media query *@
                                                            <a href="@episode.MagnetLink"
                                                               style="display:inline-block; margin:0 8px 8px 0; padding:12px 18px; background-color:@Red; color:@Ink; border:2px solid @Ink; border-radius:@WobbleSm; box-shadow:@Offset @Offset 0 @Ink; font-size:14px; font-weight:700; line-height:18px; text-decoration:none; text-align:center;">
                                                                🧲 Magnet
                                                            </a>
                                                            <a href="@episode.TorrentLink"
                                                               style="display:inline-block; margin:0 0 8px 0; padding:12px 18px; background-color:@Paper; color:@Ink; border:2px solid @Ink; border-radius:@WobbleSm; box-shadow:@Offset @Offset 0 @Ink; font-size:14px; font-weight:700; line-height:18px; text-decoration:none; text-align:center;">
                                                                📥 Torrent
                                                            </a>
                                                        </td>
                                                    </tr>
                                                    first = false;
                                                }
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    }

                    @* Tip *@
                    <tr>
                        <td style="padding:2px 0 20px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="background-color:@Blue; border:2px solid @Ink; border-radius:@Wobble; padding:14px 16px;">
                                        <p style="margin:0; font-size:13px; line-height:1.5; color:@Ink;">
                                            💡 <strong>Tip:</strong> Magnet opens straight in your torrent client. Torrent downloads the .torrent file first.
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    @* Footer *@
                    <tr>
                        <td style="padding:0 8px; text-align:center;">
                            <p style="margin:0; font-size:12px; line-height:1.5; color:@Muted;">
                                You're receiving this because you subscribed to these series.
                            </p>
                            <p style="margin:8px 0 0; font-size:11px; color:@Muted;">
                                Anime Feed Manager &copy; @DateTime.Today.Year
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
    </body>
    </html>
}

@code {
    [Parameter] public NotificationModel? ViewModel { get; set; }

    // Crayon theme (app.css). Marker faces resolve per-OS; Android falls through to sans-serif,
    // so the black outlines carry the look, not the type.
    private const string Ink = "#1b1b1b";
    private const string Paper = "#fffdf7";
    private const string Warm = "#fff6dc";
    private const string Red = "#ff4f3d";
    private const string Yellow = "#ffd23f";
    private const string Blue = "#a7d8ff";
    private const string Muted = "#5c5c5c";

    // Unquoted so Blazor's attribute encoding doesn't turn quotes into entities for email sanitizers.
    private const string Marker = "Marker Felt, Segoe Print, Chalkboard SE, ui-rounded, system-ui, sans-serif";
    private const string Offset = "3px";
    private const string Wobble = "14px 10px 16px 8px";
    private const string WobbleTop = "12px 8px 0 0";
    private const string WobbleSm = "10px 6px 12px 6px";

    public static RenderFragment AsRenderFragment(NotificationModel viewModel) => builder =>
    {
        builder.OpenComponent<NotificationEmail>(0);
        builder.AddAttribute(1, nameof(ViewModel), viewModel);
        builder.CloseComponent();
    };

}
