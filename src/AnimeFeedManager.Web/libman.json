{
  "version": "1.0",
  "defaultProvider": "jsdelivr",
  "libraries": [
    {
      "library": "htmx.org@4.0.2",
      "destination": "wwwroot/lib/htmx/",
      "files": [
        "dist/htmx.min.js",
        "dist/htmx.js"
      ]
    },
    {
      "library": "hyperscript.org@0.9.94",
      "destination": "wwwroot/lib/hyperscript/",
      "files": [
        "dist/_hyperscript.min.js",
        "dist/_hyperscript.js",
        "dist/ext/component.min.js",
        "dist/ext/component.js",
        "dist/ext/tailwind.min.js",
        "dist/ext/tailwind.js",
        "dist/ext/eventsource.min.js",
        "dist/ext/eventsource.js"
      ]
    },
    {
      "library": "@microsoft/signalr@11.0.0",
      "destination": "wwwroot/lib/signalr",
      "files": [
        "dist/browser/signalr.js",
        "dist/browser/signalr.min.js",
        "dist/browser/signalr.min.js.map"
      ]
    },
    {
      "library": "@passwordlessdev/passwordless-client@1.2.4",
      "destination": "wwwroot/lib/passwordless-client",
      "files": [
        "dist/umd/passwordless.umd.js",
        "dist/umd/passwordless.umd.min.js"
      ]
    },
    {
      "library": "apexcharts@8.9.1",
      "destination": "wwwroot/lib/apexcharts/",
      "files": [
        "dist/apexcharts.js",
        "dist/apexcharts.min.js"
      ]
    }
  ]
}