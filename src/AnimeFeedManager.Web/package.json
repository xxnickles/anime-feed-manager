{
  "name": "anime-feed-manager-client",
  "version": "1.0.0",
  "description": "A Blazor client + Tailwind",
  "main": "index.js",
  "scripts": {
    "build:js": "node build-js.mjs",
    "watch:js": "node build-js.mjs --watch",
    "build:css": "npx @tailwindcss/cli -i ./Styles/app.css -o ./wwwroot/app.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./Styles/app.css -o ./wwwroot/app.css --watch",
    "build": "npm run build:css && npm run build:js",
    "watch": "concurrently \"npm run watch:css\" \"npm run watch:js\"",
    "update:libs": "ncu -u && npm install",
    "update:libman": "node libman-update.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "chokidar": "^6.0.0",
    "concurrently": "^10.0.6",
    "daisyui": "^5.7.50",
    "glob": "^13.0.6",
    "npm-check-updates": "^23.1.1",
    "tailwindcss": "^4.3.3"
  }
}
