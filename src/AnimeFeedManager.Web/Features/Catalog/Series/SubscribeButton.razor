@* Subscribe/unsubscribe toggle for a series. Fully server-rendered from IsSubscribed on every
   request — hx-swap replaces the whole button with the server's next-state render, so there's no
   client-side toggle logic. Compact mode is the poster-overlay affordance (icon only, opposite
   corner from the airing pin); full mode is the detail-page affordance (icon + label). The compact
   form nests inside SeriesCard's card-wide <a> — "halt bubbling" keeps a click here from also
   triggering the card's navigation. *@

<form hx-post="@(IsSubscribed ? "/subscriptions/unsubscribe" : "/subscriptions/subscribe")"
      hx-target="this" hx-swap="outerHTML" _="on click halt bubbling"
      class="@(Compact ? "absolute right-2 top-2 z-10" : "w-full max-w-60")">
    <AntiforgeryToken/>
    <input type="hidden" name="SeriesId" value="@SeriesId"/>
    <input type="hidden" name="Season" value="@Season"/>
    <input type="hidden" name="Compact" value="@(Compact ? "true" : "false")"/>
    <button type="submit" aria-pressed="@(IsSubscribed ? "true" : "false")" aria-label="@Label" title="@Label"
            class="@ButtonClass">
        @if (IsSubscribed)
        {
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.85 3.5a.75.75 0 0 0-1.117-1 9.719 9.719 0 0 0-2.348 4.876.75.75 0 0 0 1.479.248A8.219 8.219 0 0 1 5.85 3.5ZM19.267 2.5a.75.75 0 1 0-1.118 1 8.22 8.22 0 0 1 1.987 4.124.75.75 0 0 0 1.48-.248A9.72 9.72 0 0 0 19.266 2.5Z"/>
                <path fill-rule="evenodd" d="M12 2.25A6.75 6.75 0 0 0 5.25 9v.75a8.217 8.217 0 0 1-2.119 5.52.75.75 0 0 0 .298 1.206c1.544.57 3.16.99 4.831 1.243a3.75 3.75 0 1 0 7.48 0 24.583 24.583 0 0 0 4.83-1.244.75.75 0 0 0 .298-1.205 8.217 8.217 0 0 1-2.118-5.52V9A6.75 6.75 0 0 0 12 2.25ZM9.75 18c0-.037 0-.075.002-.112a24.63 24.63 0 0 0 4.496 0l.002.112a2.25 2.25 0 1 1-4.5 0Z" clip-rule="evenodd"/>
            </svg>
        }
        else
        {
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="size-4" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"/>
            </svg>
        }
        @if (!Compact)
        {
            <span>@Label</span>
        }
    </button>
</form>

@code {
    [Parameter, EditorRequired] public int SeriesId { get; set; }
    [Parameter, EditorRequired] public SeriesSeason Season { get; set; } = default!;
    [Parameter] public bool IsSubscribed { get; set; }
    [Parameter] public bool Compact { get; set; }

    private string Label => IsSubscribed ? "Unsubscribe" : "Subscribe";

    private string ButtonClass => Compact
        ? "flex size-9 items-center justify-center rounded-full border-2 border-base-content bg-base-100/80 text-base-content shadow-brutal backdrop-blur-sm transition-colors aria-pressed:border-primary aria-pressed:text-primary"
        : "flex w-full items-center justify-center gap-2 rounded-lg border-2 border-base-content bg-base-100 px-3 py-2 font-display text-sm font-bold text-base-content shadow-brutal transition-colors aria-pressed:border-primary aria-pressed:bg-primary/10 aria-pressed:text-primary";
}
