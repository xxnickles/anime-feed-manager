@using AnimeFeedManager.Features.Library.Events

@* Admin operational toast for a completed import, pushed over SSE (Audience.Admin). Admins also
   receive the public SeasonImportedToast — this is a deliberate second notification (groundwork for
   a future persisted admin notification panel), carrying the import breakdown the public toast omits.
   Reuses the Notification card; root hx-swap-oob routes it into #toast-panel. Sent unnamed. *@

<div hx-swap-oob="beforeend:#toast-panel">
    <Notification Title="Library import complete" Type="Outcome.Info">
        <Message>
            <span class="font-semibold">@Imported</span> series imported for @SeasonLabel
            (@ByTypeSummary).
        </Message>
    </Notification>
</div>

@code {
    [Parameter, EditorRequired] public SeasonImported Model { get; set; } = null!;

    private string SeasonLabel => Model.Season.ToDisplayLabel();

    private int Imported => Model.ByType.Sum(type => type.Count);

    private string ByTypeSummary =>
        string.Join(", ", Model.ByType.Select(type => $"{type.Count} {type.TypeLabel}"));
}
