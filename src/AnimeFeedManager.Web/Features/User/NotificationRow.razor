@using AnimeFeedManager.Features.SystemEvents.Notifications

@if (Series is not null)
{
    <li class="list-row grid-flow-row grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-2 md:grid-cols-[minmax(0,1.4fr)_4.5rem_minmax(0,1.6fr)_minmax(0,1.6fr)]">
        <a href="@Series.Url" target="_blank" rel="noopener noreferrer" title="@Series.Title"
           class="link link-hover link-primary truncate">@Series.Title</a>
        <span class="text-right text-xs text-base-content/60"><b class="text-sm text-base-content">@Series.Episodes.Count</b> eps</span>
        <div class="col-span-full row-start-2 md:col-span-1 md:row-start-1">
            <EpisodeBar Episodes="@Series.Episodes"/>
        </div>
        <p class="col-span-full row-start-3 text-xs text-base-content/60 md:col-span-1 md:row-start-1 md:truncate"
           title="@RangesText">
            @foreach (var (label, css) in RangeParts)
            {
                <span class="@css">@label</span>
                @(" ")
            }
        </p>
    </li>
}

@code {
    [Parameter, EditorRequired] public SeriesNotifications? Series { get; set; }

    private (string Label, string? Css)[] RangeParts { get; set; } = [];
    private string RangesText { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        if (Series is null) return;

        RangeParts =
        [
            ..Series.Episodes.Segments.Select(s => s is EpisodeGap
                ? ($"[{s.Label}]", "text-primary")
                : (s.Label, (string?)null)),
            ..Series.Episodes.Rereleases.Select(r => (r, (string?)"text-base-content"))
        ];
        RangesText = string.Join(' ', RangeParts.Select(p => p.Label));
    }
}
