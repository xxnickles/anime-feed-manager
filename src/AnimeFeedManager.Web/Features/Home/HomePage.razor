@page "/"
@using AnimeFeedManager.Features.Seasons.Queries
@using AnimeFeedManager.Features.Seasons.Storage
@using AnimeFeedManager.Web.Features.Tv
@inject ITableClientFactory TableClientFactory;
@inject ILogger<HomePage> Logger;

@if (_season is not null)
{
    <AppPageTitle Title="@PageTitleForSeason(SeriesType.Tv, _season)" />
    <TvGrid Season="_season"></TvGrid>
}
else
{
    <AppPageTitle Title="@PageTitle("Home")" />
    <WarnBanner Title="No latest season!" Description="There is no latest season data available at this time"/>
}

@code {
    private SeriesSeason? _season;

    private static Result<SeriesSeason, StorageError> ParseSeason(SeasonStorage season) =>
        (season.Season ?? string.Empty, season.Year, season.Latest).ParseAsSeriesSeason()
            .MapError(StorageError (fields) => new StorageError.InvalidRecord(typeof(SeasonStorage), fields.Errors));

    protected override async Task OnInitializedAsync()
    {
        await SeasonQueries.GetLatestSeason(TableClientFactory.TableStorageLatestSeason, CancellationToken.None)
            .MapError(error => (DomainError)error)
            .Bind(stored => stored.AsFeaturedSeason())
            .Bind(ParseSeason)
            .FlushLogs(Logger)
            .Match(
                season => _season = season,
                _ => { }
            );
    }

}
