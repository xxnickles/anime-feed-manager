@page "/Login"

<AppPageTitle Title="@PageTitle("Login")" />

<section class="mx-auto flex w-full max-w-sm flex-col items-center pt-8">
    <article class="card w-full bg-base-100 shadow-sm">
        <LoginForm Model="new LoginViewModel { ReturnUrl = ReturnUrl }" />
    </article>
</section>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string ReturnUrl { get; set; } = string.Empty;
}
