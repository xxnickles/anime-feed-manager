<EditForm id="login-form"
          Model="Model"
          hx-post="/login"
          hx-swap="outerHTML"
          hx-trigger="loginComplete"
          class="card-body"
          _="@Script">
    <div>
        <h1 class="text-xl font-semibold">Sign in</h1>
        <p class="mt-1 text-sm text-base-content/70">Enter the email you registered with; your device will confirm it with a passkey.</p>
    </div>

    <fieldset class="form-control mt-4">
        <label class="label" for="email-input">
            <span class="label-text font-semibold">Email</span>
        </label>
        <input
            id="email-input"
            data-passkey-alias-input
            required
            type="email"
            placeholder="you@example.com"
            class="input input-bordered w-full"/>

        <div data-passkey-inline-error hidden class="label">
            <span class="label-text-alt text-error">Please check your email and try again</span>
        </div>
    </fieldset>

    <InputText @bind-Value="Model.Token"
               name="@nameof(Model.Token)"
               type="hidden"
               data-passkey-token-field/>

    <input type="hidden" name="@nameof(Model.ReturnUrl)" value="@Model.ReturnUrl"/>

    <fieldset class="form-control mt-6">
        <button type="submit" class="btn btn-primary" data-passkey-submit>
            <span data-passkey-submit-spinner hidden class="loading loading-spinner loading-sm"></span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.03 5.91l-2.15 2.15H10.5v2.25H8.25v2.25H4.5v-2.82a1 1 0 0 1 .3-.7l6.27-6.27A6 6 0 1 1 21.75 8.25Z"/>
            </svg>
            <span data-passkey-submit-label>Continue with passkey</span>
        </button>
        <p class="mt-2 text-xs text-base-content/60">Your browser will ask for Face ID, Touch ID, Windows Hello or a security key.</p>
    </fieldset>

    <div data-passkey-error hidden class="alert alert-error mt-4" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none"
             viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span data-passkey-error-message></span>
    </div>

    <div data-passkey-unauthorized hidden class="alert alert-warning mt-4" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none"
             viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L3.732 16c-.77.833.192 2.5 1.732 2.5z"/>
        </svg>
        <div>
            <p>Your account is not registered.</p>
            <NavLink class="link link-primary font-semibold" href="/register">Register here</NavLink>
        </div>
    </div>

    @if (HasError && Error is not null)
    {
        <div class="alert alert-error mt-4" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none"
                 viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>@ErrorMessage</span>
        </div>
    }

    <p class="mt-2 text-sm text-base-content/70">New here? <NavLink class="link link-primary font-semibold" href="/register">Create an account</NavLink></p>
</EditForm>

@code {
    [Parameter] public LoginViewModel Model { get; set; } = new();
    [Parameter] public DomainError? Error { get; set; }

    private bool HasError => Error is not null;

    private string ErrorMessage => Error switch
    {
        DomainValidationErrors e => string.Join(", ", e.Errors.SelectMany(x => x.Errors)),
        not null => Error.Message,
        _ => "Login failed. Please try again."
    };

    public static RenderFragment AsRenderFragment(LoginViewModel model, DomainError? error = null) => builder =>
    {
        builder.OpenComponent<LoginForm>(0);
        builder.AddAttribute(1, nameof(Model), model);
        builder.AddAttribute(2, nameof(Error), error);
        builder.CloseComponent();
    };

    public static RenderFragment ErrorFragment(LoginViewModel model, DomainError error) =>
        AsRenderFragment(model, error);
}
