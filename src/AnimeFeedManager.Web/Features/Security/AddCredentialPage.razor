@page "/add-credential/{UserId}"

<AppPageTitle Title="@PageTitle("Add Passkey")" />

<section class="mx-auto flex w-full max-w-sm flex-col items-center pt-8">
    <p class="mb-4 text-center text-base-content/70">Add another passkey to your account</p>
    <article class="card w-full bg-base-100 shadow-sm">
        <AddCredentialForm Model="new AddCredentialsViewModel { Id = UserId }"/>
    </article>
</section>

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;
}
