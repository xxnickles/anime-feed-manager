@if (Model.Token is not null)
{
    <div id="registration-form"
         class="card-body"
         data-passkey-token="@Model.Token"
         _="@Script">

        <div data-passkey-loading class="flex flex-col items-center gap-4">
            <span class="loading loading-spinner loading-lg text-primary"></span>
            <p class="text-center">Setting up your passkey...</p>
        </div>

        <div data-passkey-success hidden class="flex flex-col items-center gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-success h-16 w-16" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-center text-lg font-semibold">Account created successfully!</p>
            <a class="btn btn-primary" href="/login">Login now</a>
        </div>

        <div data-passkey-error hidden class="flex flex-col items-center gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-error h-16 w-16" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p data-passkey-error-message class="text-center text-error"></p>
            <a class="btn btn-outline" href="/register">Try again</a>
        </div>
    </div>
}
else
{
    <EditForm id="registration-form"
              Model="Model"
              hx-post="/create-token"
              hx-swap="outerHTML"
              hx-indicator="#registration-loader"
              class="card-body">

        <div>
            <h1 class="text-xl font-semibold">Create your account</h1>
            <p class="mt-1 text-sm text-base-content/70">We'll email you a one-time link to set up a passkey.</p>
        </div>

        <fieldset class="form-control mt-4">
            <label class="label" for="email-input">
                <span class="label-text font-semibold">Email</span>
            </label>
            <InputText
                id="email-input"
                name="@nameof(Model.Email)"
                @bind-Value="Model.Email"
                required
                type="email"
                placeholder="you@example.com"
                class="@($"input input-bordered w-full {(HasError ? "input-error" : "")}")"/>
        </fieldset>

        <fieldset class="form-control mt-4">
            <label class="label" for="display-name-input">
                <span class="label-text font-semibold">Display name</span>
            </label>
            <InputText
                id="display-name-input"
                name="@nameof(Model.DisplayName)"
                @bind-Value="Model.DisplayName"
                required
                minlength="2"
                placeholder="How we'll greet you"
                class="@($"input input-bordered w-full {(HasError ? "input-error" : "")}")"/>
        </fieldset>

        <fieldset class="form-control mt-6">
            <button type="submit" class="btn btn-primary">
                Register
            </button>
            <span id="registration-loader" class="loading loading-spinner loading-sm htmx-indicator mt-2 mx-auto"></span>
        </fieldset>

        @if (HasError && Error is not null)
        {
            <div class="alert alert-error mt-4" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none"
                     viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>@ErrorMessage</span>
            </div>
        }

        <p class="mt-2 text-sm text-base-content/70">Already have an account? <a class="link link-primary font-semibold" href="/login">Login</a></p>
    </EditForm>
}

@code {
    [Parameter] public RegisterViewModel Model { get; set; } = new();
    [Parameter] public DomainError? Error { get; set; }

    private bool HasError => Error is not null;

    private string ErrorMessage => Error switch
    {
        DomainValidationErrors validationErrors => string.Join(", ",
            validationErrors.Errors.SelectMany(e => e.Errors)),
       not null => Error.Message,
        _ =>  "Registration failed. Please try again."
    };

    public static RenderFragment AsRenderFragment(RegisterViewModel model, DomainError? error = null) => builder =>
    {
        builder.OpenComponent<RegistrationForm>(0);
        builder.AddAttribute(1, nameof(Model), model);
        builder.AddAttribute(2, nameof(Error), error);
        builder.CloseComponent();
    };

    public static RenderFragment ErrorFragment(RegisterViewModel model, DomainError error) =>
        AsRenderFragment(model, error);

    public static RenderFragment SuccessFragment(RegisterViewModel model) =>
        AsRenderFragment(model);
}
