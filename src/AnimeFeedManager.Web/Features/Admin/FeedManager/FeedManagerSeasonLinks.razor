@using AnimeFeedManager.Features.Seasons.Queries
@using AnimeFeedManager.Features.Seasons.Storage
@using AnimeFeedManager.Features.Tv.FeedManager
@inject ITableClientFactory TableClientFactory
@inject ILogger<FeedManagerSeasonLinks> Logger

@if (_seasons.Length > 0)
{
    <nav aria-label="Seasons" class="flex flex-wrap gap-2">
        @foreach (var season in _seasons)
        {
            @* Season.ToString() is the lowercase backing value. *@
            <a href="@FeedManagerRoutes.AdminSeason(season)"
               class="btn btn-sm capitalize @(IsCurrent(season) ? "btn-primary" : "btn-ghost")"
               aria-current="@(IsCurrent(season) ? "page" : null)">
                @season.Season.ToString() @season.Year.ToString()
            </a>
        }
    </nav>
}

@code {
    [Parameter, EditorRequired] public SeriesSeason Current { get; set; } = new(Shared.Types.Season.Current, Year.Current);

    private ImmutableArray<SeriesSeason> _seasons = ImmutableArray<SeriesSeason>.Empty;

    // Record equality would also compare IsLatest, which a route-parsed season never carries.
    private bool IsCurrent(SeriesSeason season) => season.ToSeasonKey() == Current.ToSeasonKey();

    protected override async Task OnInitializedAsync()
    {
        await SeasonQueries
            .GetLast4Seasons(TableClientFactory.TableStorageLatest4SeasonsGetter(Logger), CancellationToken.None)
            .Map(seasons => seasons
                .OrderByDescending(season => season.Year)
                .ThenByDescending(season => season.Season)
                .ToImmutableArray())
            .FlushLogs(Logger)
            .Match(seasons => { _seasons = seasons; },
                _ => { _seasons = []; });
    }

}
