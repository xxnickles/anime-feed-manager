@using AnimeFeedManager.Features.Feeds.Events

@* Admin operational toast for a completed airing-clock run, pushed over SSE (Audience.Admin
   only — no public counterpart, this is internal operational signal). Reuses the Notification
   card; root hx-swap-oob routes it into #toast-panel. Only sent when the run flagged something
   (see AiringClockCheckJob's Flagged > 0 guard). *@

<div hx-swap-oob="beforeend:#toast-panel">
    <Notification Title="Airing clock check complete" Type="ToastType.Info">
        <Message>
            <span class="font-semibold">@Model.FlaggedCount</span> flagged,
            <span class="font-semibold">@Model.UnmatchedCount</span> unmatched
            (@Model.ItemsScanned scanned).
        </Message>
    </Notification>
</div>

@code {
    [Parameter, EditorRequired] public AiringClockCheckRunCompleted Model { get; set; } = null!;
}
