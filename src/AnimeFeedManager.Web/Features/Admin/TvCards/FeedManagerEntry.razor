@using AnimeFeedManager.Features.Tv.FeedManager
<div class="flex flex-wrap items-center gap-x-5 gap-y-3 px-5 py-4">
    <div class="flex flex-col gap-1 flex-[1_1_200px] min-w-0">
        <h3 class="m-0 text-sm font-semibold">Feed manager</h3>
        <p class="text-xs text-base-content/70">Bind series SubsPlease doesn't carry to a nyaa release.</p>
    </div>
    @* Season.ToString() is the lowercase backing value. *@
    <a href="@Link" class="btn btn-outline capitalize">Open @_season.Season.ToString() @_season.Year.ToString()</a>
</div>

@code {
    private readonly SeriesSeason _season = new(Shared.Types.Season.Current, Year.Current);
    private string Link => FeedManagerRoutes.AdminSeason(_season);
}
