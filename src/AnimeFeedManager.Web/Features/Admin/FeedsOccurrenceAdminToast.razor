@using AnimeFeedManager.Features.Feeds.Entities

@* Admin toast for a live FeedsOccurrence (Audience.Admin only, no public counterpart).
   Generic by Kind/Summary so any future FeedsOccurrence kind gets a toast for free. *@

<div hx-swap-oob="beforeend:#toast-panel">
    <Notification Title="@Model.Source" Type="Model.Outcome">
        <Message>
            <span>@Model.Kind — @Model.Summary</span>
        </Message>
    </Notification>
</div>

@code {
    [Parameter, EditorRequired] public FeedsOccurrence Model { get; set; } = null!;
}
