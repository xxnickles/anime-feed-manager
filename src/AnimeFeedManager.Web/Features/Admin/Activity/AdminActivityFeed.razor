@using System.Collections.Immutable
@using AnimeFeedManager.Features.Admin.Activity
@using AnimeFeedManager.Features.Feeds.Entities.Storage
@using AnimeFeedManager.Features.Library.Entities.Storage
@inject ICosmosContainerFactory Factory
@inject ILogger<AdminActivityFeed> Logger

@* Unified admin-only feed of recent operational events across buckets (Library import
   failures/successes, Feeds job runs, Feeds occurrences like Jikan degradation), source-tagged,
   each row rendered natively by its concrete type. Loading is server-side (SSR), same convention
   as SeasonGrid: inject the container factory, build the loaders inline, hand them to
   AdminActivityFeedQuery (Features-owned — sequential Bind/Map, no concurrent Cosmos reads). *@

@if (_error)
{
    <WarnBanner Title="Couldn't load recent activity"
                Description="Something went wrong reading the activity feed. Refresh to try again." />
}
else if (_items.Length is 0)
{
    <WarnBanner Title="No recent activity"
                Description="Nothing has run yet." />
}
else
{
    <div class="flex flex-col gap-2">
        @foreach (var item in _items)
        {
            <ActivityRow Model="item" />
        }
    </div>
}

@code {
    private const int PerSourceTake = 10;
    private const int OverallTake = 20;

    private ImmutableArray<IPersistedEvent> _items = [];
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        await AdminActivityFeedQuery.Execute(
                Factory.RecentLibraryEventsLoaderHandler(),
                Factory.RecentCollectionRunsLoaderHandler(),
                Factory.RecentFeedsOccurrencesLoaderHandler(),
                PerSourceTake, OverallTake, CancellationToken.None)
            .FlushLogs(Logger)
            .Match(
                items => _items = items,
                _ => _error = true);
    }
}
