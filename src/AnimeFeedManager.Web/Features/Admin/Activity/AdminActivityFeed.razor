@using System.Collections.Immutable
@using AnimeFeedManager.Features.Admin.Activity
@using AnimeFeedManager.Features.Feeds.Storage
@using AnimeFeedManager.Features.Library.Entities.Storage
@inject ICosmosContainerFactory Factory
@inject ILogger<AdminActivityFeed> Logger

@* Unified admin-only feed of recent operational events (Library import, Feeds job runs, Feeds
   occurrences), rows rendered by ActivityRow. Server-side (SSR): inject the container factory,
   build loaders inline, hand them to AdminActivityFeedQuery (Features-owned Bind/Map chain).
   Also the response body for GET /admin/activity (see ActivityEndpoints) — the live-refresh
   target for the SSE "activity-changed" signal (see NotificationsRegistration); every render is
   a fresh query, so pill counts are always correct, no client-side recompute needed. *@

@* _="@Script" is bound here, not on a page-level ancestor — this whole subtree is what
   GET /admin/activity replaces on every live refresh, and hyperscript's runtime reinstalls _=
   scripts on any newly-inserted element, so the filter click-handler stays correctly wired to
   whatever buttons/rows are currently rendered. *@
<div _="@Script">
    <div role="group" aria-label="Filter by outcome" class="mb-1 flex flex-wrap gap-2">
        <FilterPill Value="all" Pressed="true">
            All <span class="ml-1 font-mono text-[0.68rem] opacity-70">@_items.Length</span>
        </FilterPill>
        <FilterPill Value="succeeded">
            Succeeded <span class="ml-1 font-mono text-[0.68rem] opacity-70">@SucceededCount</span>
        </FilterPill>
        <FilterPill Value="error">
            Error <span class="ml-1 font-mono text-[0.68rem] opacity-70">@ErrorCount</span>
        </FilterPill>
    </div>

    <div id="activity-list" class="flex flex-col gap-2">
        @if (_error)
        {
            <WarnBanner Title="Couldn't load recent activity"
                        Description="Something went wrong reading the activity feed. Refresh to try again." />
        }
        else if (_items.Length is 0)
        {
            <WarnBanner Title="No recent activity"
                        Description="Nothing has run yet." />
        }
        else
        {
            @foreach (var item in _items)
            {
                <ActivityRow Model="item" />
            }
        }
    </div>
</div>

@code {
    // Shared by the SSE bindings (NotificationsRegistration) and the hx-trigger in Admin.razor —
    // one constant so the publisher and the listener can't drift out of sync.
    public const string RefreshSseEvent = "activity-changed";

    private const int PerSourceTake = 10;
    private const int OverallTake = 20;

    private ImmutableArray<IPersistedEvent> _items = [];
    private bool _error;

    private int SucceededCount => _items.Count(item => ActivityRow.Bucket(item.Outcome) == "succeeded");
    private int ErrorCount => _items.Count(item => ActivityRow.Bucket(item.Outcome) == "error");

    protected override async Task OnInitializedAsync()
    {
        await AdminActivityFeedQuery.Execute(
                Factory.RecentLibraryEventsLoaderHandler(),
                Factory.RecentCollectionRunsLoaderHandler(),
                Factory.RecentFeedsOccurrencesLoaderHandler(),
                PerSourceTake, OverallTake, CancellationToken.None)
            .FlushLogs(Logger)
            .Match(
                items => _items = items,
                _ => _error = true);
    }
}
