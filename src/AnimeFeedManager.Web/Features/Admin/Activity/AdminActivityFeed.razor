@using System.Collections.Immutable
@using AnimeFeedManager.Features.Admin.Activity
@using AnimeFeedManager.Features.Feeds.Entities.Storage
@using AnimeFeedManager.Features.Library.Entities.Storage
@inject ICosmosContainerFactory Factory
@inject ILogger<AdminActivityFeed> Logger

@* Unified admin-only feed of recent operational events (Library import, Feeds job runs, Feeds
   occurrences), rows rendered by ActivityRow. Server-side (SSR): inject the container factory,
   build loaders inline, hand them to AdminActivityFeedQuery (Features-owned Bind/Map chain). *@

@* Pills are skipped on an SSE-triggered refresh (Model is not null there) so a live update never
   resets the user's current filter selection — only #activity-list is meant to change. *@
@if (Model is null)
{
    <div role="group" aria-label="Filter by outcome" class="mb-1 flex flex-wrap gap-2">
        <FilterPill Value="all" Pressed="true">
            All <span id="activity-count-all" class="ml-1 font-mono text-[0.68rem] opacity-70">@_items.Length</span>
        </FilterPill>
        <FilterPill Value="succeeded">
            Succeeded <span id="activity-count-succeeded" class="ml-1 font-mono text-[0.68rem] opacity-70">@SucceededCount</span>
        </FilterPill>
        <FilterPill Value="error">
            Error <span id="activity-count-error" class="ml-1 font-mono text-[0.68rem] opacity-70">@ErrorCount</span>
        </FilterPill>
    </div>
}

@* activity-list: SSE refresh target (NotificationsRegistration) — present in every branch, not
   just the row list. _="@Script" recomputes the pill counts (ids above) whenever this element's
   own row set changes, whether that's this refresh or a later live one. *@
<div id="activity-list" class="flex flex-col gap-2" _="@Script">
    @if (_error)
    {
        <WarnBanner Title="Couldn't load recent activity"
                    Description="Something went wrong reading the activity feed. Refresh to try again." />
    }
    else if (_items.Length is 0)
    {
        <WarnBanner Title="No recent activity"
                    Description="Nothing has run yet." />
    }
    else
    {
        @foreach (var item in _items)
        {
            <ActivityRow Model="item" />
        }
    }
</div>

@code {
    private const int PerSourceTake = 10;
    private const int OverallTake = 20;

    // AddHtml<TEvent,TComponent> always binds the payload as "Model", so LibraryEvent/
    // FeedsOccurrence/CollectionRun (all IPersistedEvent) can bind straight to this component as
    // a live-refresh trigger (see NotificationsRegistration). The payload itself is never read —
    // only checked for null, to tell a refresh pass from the normal page embed (see Model is null
    // above).
    [Parameter] public IPersistedEvent? Model { get; set; }

    private ImmutableArray<IPersistedEvent> _items = [];
    private bool _error;

    private int SucceededCount => _items.Count(item => ActivityRow.Bucket(item.Outcome) == "succeeded");
    private int ErrorCount => _items.Count(item => ActivityRow.Bucket(item.Outcome) == "error");

    protected override async Task OnInitializedAsync()
    {
        await AdminActivityFeedQuery.Execute(
                Factory.RecentLibraryEventsLoaderHandler(),
                Factory.RecentCollectionRunsLoaderHandler(),
                Factory.RecentFeedsOccurrencesLoaderHandler(),
                PerSourceTake, OverallTake, CancellationToken.None)
            .FlushLogs(Logger)
            .Match(
                items => _items = items,
                _ => _error = true);
    }
}
