@* TV reconciliation trigger. No data to send, but we still post a <form> so the antiforgery
   token rides along (the Noop construct). htmx posts to the Feeds admin endpoint, which fires
   the reconciliation run (JobExecutor, single-flight "tv-reconciliation" gate — shared with the
   30-min cron) and returns an out-of-band toast as feedback. hx-swap="none" leaves this card
   untouched; transition:false keeps the toast response out of the view transition. *@

<div data-loader-host
     class="relative flex h-full flex-col gap-3 rounded-2xl border-2 border-base-content bg-base-100 p-5 shadow-brutal">
    <div class="flex flex-col gap-1">
        <span class="mb-0.5 inline-flex size-9 items-center justify-center rounded-lg border-2 border-base-content bg-primary/15 text-primary">
            @AdminIcons.TvReconciliation
        </span>
        <h3 class="font-display text-base font-black tracking-[-0.02em] text-base-content">
            TV Reconciliation
        </h3>
        <p class="text-sm text-base-content/70">
            Match Nyaa against every currently-airing TV series now.
        </p>
    </div>

    <form hx-post="/admin/feeds/nyaa/tv-reconciliation"
          hx-swap="none transition:false"
          hx-confirm="Run TV reconciliation now?"
          hx-indicator="closest [data-loader-host]"
          class="mt-auto">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-primary">
            Run reconciliation
        </button>
    </form>

    <SectionLoader Operation="Running TV reconciliation…" />
</div>
