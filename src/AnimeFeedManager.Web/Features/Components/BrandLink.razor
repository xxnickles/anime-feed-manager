<NavLink href="/"
         class="!no-underline normal-case flex items-center gap-2"
         aria-label="Anime Feed Manager - Home">
    @if (ShowMascot)
    {
        <img src="/images/logo.svg" alt="" class="max-md:h-11 md:h-9 w-auto shrink-0" aria-hidden="true" />
    }
    <span class="truncate max-md:text-3xl md:text-xl font-bold font-logo bg-gradient-to-r from-secondary to-accent bg-clip-text text-transparent">Anime Feed Manager</span>
</NavLink>

@code {
    [Parameter] public bool ShowMascot { get; set; } = true;
}