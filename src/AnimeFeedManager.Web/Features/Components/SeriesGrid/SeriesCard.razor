@if (SeriesInfo is not null)
{
    <article id="@Id" class="card card-side card-border card-sm bg-base-100 border-base-300 shadow-sm hover:shadow-md transition-shadow duration-200 h-56 overflow-hidden relative">
        <div id="@LoaderId" class="absolute top-2 right-2 opacity-0 htmx-indicator z-10">
            <span class="loading loading-spinner loading-sm"></span>
        </div>

        <figure class="relative grid w-32 md:w-48 shrink-0">
            <img alt="@SeriesInfo.Title" class="col-start-1 row-start-1 h-full w-full object-cover" loading="lazy" src="@SeriesInfo.ImageUrl"/>
            @if (CardBadge is not null)
            {
                <div class="col-start-1 row-start-1 m-1.5 self-start justify-self-start">
                    @CardBadge
                </div>
            }
        </figure>

        <div class="card-body min-w-0 overflow-hidden">
            <h2 class="card-title text-sm wrap-break-word line-clamp-2">@SeriesInfo.Title</h2>

            @if (SeriesInfo.LastUpdated is not null)
            {
                <span class="text-xs opacity-60 shrink-0">
                    Updated @SeriesInfo.LastUpdated.Value.ToString("yyyy-MM-dd")
                </span>
            }

            <div class="text-xs opacity-80 leading-relaxed flex-1 min-h-0 overflow-y-auto pr-1 scrollbar">
                @if (!string.IsNullOrWhiteSpace(SeriesInfo.Synopsis))
                {
                    @SeriesInfo.Synopsis
                }
                else
                {
                    <span class="text-warning flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                             stroke="currentColor" class="size-4 shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
                        </svg>
                        Synopsis Not Available
                    </span>
                }
            </div>

            @if (CardActions is not null)
            {
                <div class="card-actions">
                    @CardActions
                </div>
            }
        </div>
    </article>
}

@code {
    [Parameter] public SeriesCardViewModel? SeriesInfo { get; set; }
    [Parameter] public RenderFragment? CardBadge { get; set; }
    [Parameter] public RenderFragment? CardActions { get; set; }
    [Parameter, EditorRequired] public string LoaderId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
}
