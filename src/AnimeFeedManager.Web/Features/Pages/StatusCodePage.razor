@page "/status-code/{StatusCode:int}"
@layout Layout.MainLayout
@using AnimeFeedManager.Web.Features.Components.Responses
@inject IHttpContextAccessor HttpContextAccessor

@* A partial request came from an in-page control: answer out-of-band only, so htmx skips the main swap
   and no inline <title> retitles the page. 4xx gets a toast, 5xx the error dialog. *@
@if (_isPartialRequest)
{
    @if (StatusCode >= StatusCodes.Status500InternalServerError)
    {
        <ErrorDialogOob Title="@GetPageTitle()"
                        Message="@Notifications.TextBody(GetToastMessage())"
                        StatusCode="@StatusCode" />
    }
    else
    {
        <NotificationOob Title="@GetPageTitle()"
                         Message="@Notifications.TextBody(GetToastMessage())"
                         Type="@(StatusCode == StatusCodes.Status404NotFound ? ToastType.Info : ToastType.Error)" />
    }
}
else
{
    <AppPageTitle Title="@PageTitle(GetPageTitle())" />

    <div class="hero min-h-[60vh]">
        <div class="hero-content text-center flex-col">
            @if (StatusCode == 404)
            {
                <img src="images/404.svg" alt="Page not found" class="max-w-xs md:max-w-sm" />

                <div class="max-w-md">
                    <h1 class="text-5xl font-bold">Not Found</h1>
                    <p class="py-6">Sorry, the page you are looking for does not exist.</p>
                    <a href="/" class="btn btn-primary">Go Home</a>
                </div>
                <p class="text-xs opacity-50">
                    <a href="https://www.vecteezy.com/" target="_blank" rel="noopener noreferrer" class="link">
                        Illustration by Vecteezy
                    </a>
                </p>

            }
            else
            {
                <div class="max-w-md">
                    <h1 class="text-5xl font-bold">@StatusCode</h1>
                    <p class="py-6">An error occurred while processing your request.</p>
                    <a href="/" class="btn btn-primary">Go Home</a>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public int StatusCode { get; set; }

    private bool _isPartialRequest;

    protected override void OnInitialized()
    {
        _isPartialRequest = HttpContextAccessor.GetHtmxRequestType() is Partial;
    }

    private string GetPageTitle() => StatusCode switch
    {
        404 => "Page Not Found",
        _ => $"Error {StatusCode}"
    };

    private string GetToastMessage() => StatusCode switch
    {
        404 => "The requested resource was not found.",
        _ => "An error occurred while processing your request."
    };
}
