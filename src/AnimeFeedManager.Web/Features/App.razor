@using AnimeFeedManager.Web.Features.Security
@using AnimeFeedManager.Web.Htmx
@inject IWebHostEnvironment Env
@inject IHttpContextAccessor HttpContextAccessor

@{
    // Model B (htmx 4 persistent shell): a full HTML document is rendered ONLY for a normal
    // browser navigation (Html). Every htmx request — boosted page nav (HxFull) and targeted
    // component swaps (HxPartial) alike — returns the bare <Routes/> fragment; MainLayout
    // then shapes it per request type (boosted nav wraps #main-content + OOB topbar; a
    // partial swap returns just the target).
    var isHtmxRequest = HttpContextAccessor.GetHtmxRequestType() is Htmx;

    // SSE endpoint for the current viewer's max entitled audience, mapped from the canonical
    // AppUser projection. The single connect element below opens exactly one connection at this
    // level. Rendered only in the full document; it persists across boosted navigations (only
    // #main-content swaps) and is rebuilt on every full reload — including the full-reload
    // login/logout transitions (HxRedirect) — so it reconnects to the right endpoint automatically.
    var sseLevel = HttpContextAccessor.HttpContext?.GetCurrentUser() switch
    {
        AdminUser => "admin",
        RegularUser => "registered",
        _ => "public"
    };
}

@if (isHtmxRequest)
{
    <Routes />
}
else
{
    <!DOCTYPE html>
    <html lang="en" class="scroll-pt-16">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="Track and manage your anime season library." />
        <meta name="theme-color" content="#1a1a2e" />

        @* htmx 4 renamed globalViewTransitions → transitions (default false). Enabling it
           globally is the only lever that gives the Back/Forward history-restore swap a view
           transition, since that path has no per-element hx-swap to carry transition:true.
           Forward boosted nav also opts in via the body boost config; the OOB topbar opts OUT
           with transition:false so the shell doesn't cross-fade. *@
        <meta name="htmx-config" content='{"transitions": true}' />

        <!-- Web fonts (cdnfonts) -->
        <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
        <link href="https://fonts.cdnfonts.com/css/inter" rel="stylesheet" />
        <link href="https://fonts.cdnfonts.com/css/archivo" rel="stylesheet" />
        <link href="https://fonts.cdnfonts.com/css/sf-mono" rel="stylesheet" />

        <base href="/" />

        <script>
            // Re-apply the user's stored theme before first paint. Absent => no data-theme
            // attribute, so daisyui's paper-light (--default) / paper-dark (--prefersdark)
            // follow the system preference. Kept in sync by ThemeSelector.razor.
            (function () {
                const theme = localStorage.getItem('user-theme');
                if (theme) {
                    document.documentElement.setAttribute('data-theme', theme);
                }
            })();
        </script>

        <link rel="stylesheet" href="@Assets["app.css"]" />
        <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />

        <ImportMap />
        <HeadOutlet />
    </head>

    <body class="bg-base-200 min-h-screen min-w-[380px] has-[#mobile-drawer:checked]:overflow-hidden"
          hx-boost:inherited="swap:outerSync select:#main-content target:#main-content transition:true show:top">

        <Routes />

        @* Toast host — OOB notifications append here (newest nearest the corner). daisyUI's
           `toast` owns positioning, column layout, gap and the enter animation; the only add is
           z-[200] so toasts clear the z-[100] mobile menu. hx-preserve keeps the stack across
           full-document / back-forward body swaps. *@
        <div id="toast-panel" class="toast toast-bottom toast-start z-[200]" hx-preserve></div>

        @* Single SSE connection for the whole session, opened at the viewer's audience level. Messages
           arrive unnamed and carry their own hx-swap-oob target (e.g. #toast-panel), so this element
           needs no hx-target/hx-swap of its own. The hx-sse extension self-activates from the attribute
           (script loaded below); no hx-ext opt-in. *@
        <div id="sse-connect" hx-sse:connect="/sse/@sseLevel" class="hidden" aria-hidden="true"></div>

        @* Custom confirm dialog — intercepts hx-confirm app-wide (replaces window.confirm). *@
        <HtmxConfirm />

        @if (Env.IsDevelopment())
        {
            <script defer src="@Assets["lib/htmx/dist/htmx.js"]"></script>
            <script defer src="@Assets["lib/htmx/dist/ext/hx-sse.js"]"></script>
            <script defer src="@Assets["lib/hyperscript/dist/_hyperscript.js"]"></script>
            <script defer src="@Assets["lib/hyperscript/dist/ext/component.js"]"></script>
        }
        else
        {
            <script defer src="@Assets["lib/htmx/dist/htmx.min.js"]"></script>
            <script defer src="@Assets["lib/htmx/dist/ext/hx-sse.min.js"]"></script>
            <script defer src="@Assets["lib/hyperscript/dist/_hyperscript.min.js"]"></script>
            <script defer src="@Assets["lib/hyperscript/dist/ext/component.min.js"]"></script>
        }

        @* App-wide hyperscript behaviours, defined once in the persistent shell. External
           .hs file so the <selector/> queries inside don't trip Razor's attribute parser;
           hyperscript fetches and processes it. Elements opt in via `_="install Name"`. *@
        <script type="text/hyperscript" src="@Assets["app/forms.hs"]"></script>

    </body>

    </html>
}
