@using System.Web
@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized>
        <div class="flex items-center gap-2 overflow-hidden">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-secondary text-xs font-bold text-secondary-content"
                  aria-hidden="true">
                @Initials(context.User.Identity?.Name)
            </span>
            <div class="min-w-0 leading-tight">
                <div class="truncate text-sm">@context.User.Identity?.Name</div>
                <NavLink href="@GetLogoutPath()" class="text-xs text-base-content/60 hover:text-base-content"
                         hx-swap="outerHTML swap:300ms">
                    Sign out
                </NavLink>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="flex flex-col gap-1">
            <NavLink href="@GetLoginPath()"
                     class="max-lg:justify-center flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-base-content/70 hover:bg-base-200 hover:text-base-content"
                     hx-swap="outerHTML swap:300ms">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                     stroke="currentColor" class="size-5 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>
                </svg>
                <span>Login</span>
            </NavLink>
            <NavLink href="register"
                     class="max-lg:justify-center flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-base-content/70 hover:bg-base-200 hover:text-base-content"
                     hx-swap="outerHTML swap:300ms">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                     stroke="currentColor" class="size-5 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z"/>
                </svg>
                <span>Register</span>
            </NavLink>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string? ReturnUrlKey = "returnUrl";

    private string GetLoginPath() => GetWithReturn("login");
    private string GetLogoutPath() => GetWithReturn("logout");

    private string GetWithReturn(string basePath)
    {
        var currentUri = new Uri(NavigationManager.Uri);
        var returnValue = HttpUtility.ParseQueryString(currentUri.Query).Get(ReturnUrlKey);
        var returnPath = !string.IsNullOrEmpty(returnValue) ? returnValue : currentUri.AbsolutePath;
        return $"{basePath}?returnUrl={HttpUtility.UrlEncode(returnPath)}";
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var local = name.Split('@')[0];
        return local.Length <= 2 ? local.ToUpperInvariant() : local[..2].ToUpperInvariant();
    }
}
