<div class="drawer md:drawer-open">
    <input id="drawer" type="checkbox" class="drawer-toggle" hx-preserve/>
    <div class="drawer-content flex min-h-screen flex-col">
        <NavBar></NavBar>
        @ChildContent
    </div>
    <div class="drawer-side z-40 max-md:is-drawer-close:overflow-visible md:is-drawer-open:overflow-visible">
        <label for="drawer" aria-label="close sidebar" class="drawer-overlay md:hidden"></label>
        <div class="w-[236px] md:is-drawer-close:w-[236px] md:is-drawer-open:w-[60px] flex min-h-full flex-col border-r border-base-300 bg-base-200 transition-[width] duration-200">
            <div class="flex items-center overflow-hidden border-b border-base-300 px-3 py-4">
                <BrandLink/>
            </div>
            <SideMenu/>
            <div class="max-md:is-drawer-close:hidden md:is-drawer-open:hidden overflow-hidden border-t border-base-300 px-2 py-1">
                <AppVersion/>
            </div>
            <div class="overflow-hidden border-t border-base-300 px-2 py-3">
                <NavAuthButtons/>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
