@inherits LayoutComponentBase
@inject IHttpContextAccessor HttpContextAccessor

@if (_isPartialRequest)
{
    @Body
}
else
{
    <AppShell>
        <main id="main-content" class="px-4 md:px-8">
            @Body
        </main>
    </AppShell>
}

@code {
    private bool _isPartialRequest;

    protected override void OnInitialized()
    {
        _isPartialRequest = HttpContextAccessor.GetHtmxRequestType() is Partial;
    }
}
