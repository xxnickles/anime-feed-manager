@using AnimeFeedManager.Features.Tv.FeedManager
@using AnimeFeedManager.Features.Tv.Library.Queries
@using AnimeFeedManager.Web.Features.Tv.Controls
@implements IRenderableComponent<UserTvSeries>

@if (Series is not null)
{
    <CardWrapper FilterAttributes="@FilterAttributesHelper.GetFilterAttributes(Series)">
        <SeriesCard SeriesInfo="@Series.TvSeries.AsSeriesCard()" LoaderId="@_loaderId" Id="@_cardId">
            <CardBadge>
                @switch (Series)
                {
                    case Available:
                    case AvailableForSubscription:
                        <Badge Text="Available" Type="StatusType.Success"></Badge>
                        break;
                    case Subscribed:
                        <Badge Text="Subscribed" Type="StatusType.Primary"></Badge>
                        break;
                    case Interested:
                        <Badge Text="Interested" Type="StatusType.Secondary"></Badge>
                        break;
                    case Completed:
                        <Badge Text="Completed" Type="StatusType.Info"></Badge>
                        break;
                    default:
                        <Badge Text="Not Available" Type="StatusType.Warning"></Badge>
                        break;
                }
            </CardBadge>

            <CardActions>
                <a href="@FeedManagerRoutes.Releases(Series.TvSeries.Id)" class="btn btn-sm btn-outline gap-1.5"
                   aria-label="Releases for @Series.TvSeries.Title">
                    <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>
                    Releases
                </a>
                @if (Series.User is AuthenticatedUser)
                {
                    @switch (Series)
                    {
                        case AvailableForSubscription:
                            <ForSubscription Model="@GetActionModel(Series)"></ForSubscription>
                            break;
                        case Subscribed:
                            <ForSubscriptionRemoval Model="@GetActionModel(Series)"></ForSubscriptionRemoval>
                            break;
                        case AvailableForFuture:
                            <ForInterested Model="@GetActionModel(Series)"></ForInterested>
                            break;
                        case Interested:
                            <ForInterestedRemoval Model="@GetActionModel(Series)"></ForInterestedRemoval>
                            break;
                    }

                    @if (Series.User is AdminUser)
                    {
                        <AdminActionsMenu>
                            <Buttons>
                                <SeriesDeleter Model="GetRemoveSeries(Series)"></SeriesDeleter>
                            </Buttons>
                        </AdminActionsMenu>
                    }
                }
            </CardActions>
        </SeriesCard>
    </CardWrapper>
}

@code {
    [Parameter, EditorRequired] public UserTvSeries? Series { get; set; }
    private string _loaderId = string.Empty;
    private string _loaderSelector = string.Empty;
    private string _cardId = string.Empty;

    protected override void OnInitialized()
    {
        _loaderId = IdHelpers.GetUniqueName("card-loader");
        _cardId = IdHelpers.GetUniqueName("card");
        _loaderSelector = $"#{_loaderId}";
    }

    public static RenderFragment AsRenderFragment(UserTvSeries series) => builder =>
    {
        builder.OpenComponent<TvCard>(0);
        builder.AddAttribute(1, nameof(Series), series);
        builder.CloseComponent();
    };

    private TvSeriesActionViewModel GetActionModel(UserTvSeries series) => new()
    {
        SeriesId = series.TvSeries.Id,
        SeriesTitle = series.TvSeries.Title,
        LoaderSelector = _loaderSelector
    };

    private RemoveSeriesViewModel GetRemoveSeries(UserTvSeries series)
    {
        return new RemoveSeriesViewModel
        {
            SeriesTitle = series.TvSeries.Title,
            SeriesId = series.TvSeries.Id,
            LoaderSelector = _loaderSelector,
            CardId = _cardId
        };
    }

}