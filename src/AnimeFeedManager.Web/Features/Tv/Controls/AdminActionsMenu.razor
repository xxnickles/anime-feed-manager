@* Compact popover menu for admin-only card actions (alt-titles edit, delete).
   Uses daisyUI's Popover API + anchor positioning method, not details/summary —
   the menu renders on the browser's top layer, so it isn't clipped by an
   ancestor's overflow-hidden (SeriesCard's card body scrolls its synopsis). *@
<button type="button"
        class="btn btn-secondary btn-sm btn-circle"
        popovertarget="@_id"
        style="anchor-name:--@_id"
        aria-haspopup="true"
        aria-label="More actions">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
         stroke="currentColor" class="size-4" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M6 12h.008v.008H6V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM12 12h.008v.008H12V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM18 12h.008v.008H18V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
    </svg>
</button>
<ul class="dropdown menu bg-base-100/80 backdrop-blur-md rounded-box shadow-xl w-52 p-2"
    popover
    id="@_id"
    style="position-anchor:--@_id; --anchor-v:top; --anchor-h:right;">
    @Buttons
</ul>

@code {
    [Parameter] public RenderFragment? Buttons { get; set; }

    private readonly string _id = IdHelpers.GetUniqueName("admin-actions");
}
