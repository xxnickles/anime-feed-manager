@if (Model is not null)
{
    <li>
        <button type="button"
                aria-label="Manage Alternative Titles for @Model.SeriesTitle"
                _="on click remove @@open from the closest <details/> then call (the next <dialog/>).showModal()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                 stroke="currentColor"
                 class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            Edit Alternative Titles
        </button>
    </li>

    <dialog class="modal">
        <AlternativeTitlesEditor Model="Model"></AlternativeTitlesEditor>
    </dialog>
}
@code {
    [Parameter, EditorRequired] public AlternativeTitlesViewModel? Model { get; set; }
}